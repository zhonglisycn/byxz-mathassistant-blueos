<template>
  <div class="page circuit">
    <div class="stage">
    <div class="hd">
      <text class="back" @click="back">‹</text>
      <text class="title">电路图</text>
      <text class="tpl" @click="cycleTemplate">模板</text>
    </div>

    <div class="tabs">
      <div class="tab {{mode=='schematic' ? 'tab-on' : 'tab-off'}}" @click="setMode('schematic')">
        <text class="tab-t">电路图</text>
      </div>
      <div class="tab {{mode=='real' ? 'tab-on' : 'tab-off'}}" @click="setMode('real')">
        <text class="tab-t">实物图</text>
      </div>
    </div>

    <text class="status">{{status}}</text>
    <div class="clr" @click="clearAll"><text class="clr-t">清空</text></div>

    <div class="line line-empty" for="{{guides}}" tid="i" style="left:{{$item.x}}px;top:{{$item.y}}px;width:{{$item.w}}px;height:{{$item.h}}px;min-width:{{$item.w}}px;min-height:{{$item.h}}px"></div>

    <div class="line {{$item.cls}}" for="{{lines}}" tid="i" style="left:{{$item.x}}px;top:{{$item.y}}px;width:{{$item.w}}px;height:{{$item.h}}px;min-width:{{$item.w}}px;min-height:{{$item.h}}px"></div>

    <div class="slot" for="{{slots}}" tid="i" style="left:{{$item.x}}px;top:{{$item.y}}px;width:{{$item.w}}px;height:{{$item.h}}px;min-width:{{$item.w}}px;min-height:{{$item.h}}px" @click="tapEdge($item.a, $item.b)"></div>

    <div class="comp" for="{{comps}}" tid="i" style="left:{{$item.x}}px;top:{{$item.y}}px;width:{{$item.cw}}px;height:{{$item.ch}}px;min-width:{{$item.cw}}px;min-height:{{$item.ch}}px" @click="tapComp($item.id)">
      <text class="clabel">{{$item.label}}</text>
      <image class="cimg" src="{{$item.img}}" style="left:{{$item.ix}}px;top:{{$item.iy}}px;width:{{$item.iw}}px;height:{{$item.ih}}px"></image>
      <text class="creading" if="{{$item.curText}}">{{$item.curText}}</text>
    </div>

    <div class="node" for="{{nodes}}" tid="i" style="left:{{$item.x}}px;top:{{$item.y}}px">
      <div class="ndot"></div>
    </div>

    <div class="palette" if="{{mode=='schematic'}}">
      <div class="pbtn {{$item.on}}" for="{{paletteItems}}" tid="i" @click="setPalette($item.k)">
        <image class="pimg" if="{{$item.icon}}" src="{{$item.icon}}"></image>
        <text class="pbtn-t">{{$item.name}}</text>
      </div>
    </div>

    <text class="hint">{{hintText}}</text>
    </div>
  </div>
</template>

<script>
import router from '@blueos.app.appmanager.router'
import appGlobal from '../../common/core/app.js'
import { analyzeCircuit } from '../../common/core/circuit.js'

const NX = [54, 162, 270, 378]
const NY = [128, 216, 304, 392]

const TEMPLATES = [
  {
    name: '串联',
    edges: [
      [0, 1, 'bulb'], [1, 2, 'bulb'], [2, 3, 'wire'],
      [3, 7, 'wire'], [7, 11, 'switch'], [11, 15, 'wire'],
      [15, 14, 'wire'], [14, 13, 'battery'], [13, 12, 'wire'],
      [12, 8, 'wire'], [8, 4, 'wire'], [4, 0, 'wire'],
    ],
  },
  {
    name: '并联',
    edges: [
      [0, 4, 'wire'], [4, 8, 'wire'], [8, 12, 'wire'],
      [3, 7, 'wire'], [7, 11, 'wire'], [11, 15, 'wire'],
      [4, 5, 'wire'], [5, 6, 'bulb'], [6, 7, 'wire'],
      [8, 9, 'wire'], [9, 10, 'bulb'], [10, 11, 'wire'],
      [12, 13, 'switch'], [13, 14, 'battery'], [14, 15, 'wire'],
    ],
  },
  {
    name: '测电流',
    edges: [
      [0, 1, 'battery'], [1, 2, 'ammeter'], [2, 3, 'switch'],
      [3, 7, 'wire'], [7, 11, 'wire'], [11, 15, 'wire'],
      [15, 14, 'wire'], [14, 13, 'bulb'], [13, 12, 'wire'],
      [12, 8, 'wire'], [8, 4, 'wire'], [4, 0, 'wire'],
    ],
  },
]

const PALETTE = [
  { k: 'wire', name: '导线' },
  { k: 'battery', name: '电池' },
  { k: 'bulb', name: '灯泡' },
  { k: 'switch', name: '开关' },
  { k: 'ammeter', name: '电流表' },
  { k: 'erase', name: '删除' },
]

const TYPE_NAME = { wire: '导线', battery: '电池', bulb: '灯泡', switch: '开关', ammeter: '电流表' }

// 图标尺寸按 circuit-lab 的符号比例摆放；竖边直接用旋转版素材
const ICON_SIZE = {
  schematic: {
    battery: { h: [84, 40], v: [40, 84] },
    lamp: { h: [64, 33], v: [33, 64] },
    switch: { h: [84, 0], v: [0, 84] },
    ammeter: { h: [64, 33], v: [33, 64] },
  },
  physical: {
    battery: { h: [74, 43], v: [43, 74] },
    lamp: { h: [64, 48], v: [48, 64] },
    switch: { h: [74, 0], v: [0, 74] },
    ammeter: { h: [56, 56], v: [56, 56] },
  },
}
const ICON_RATIO = {
  schematic: {
    switch: { closed: 16 / 156, open: 45 / 156 },
  },
  physical: {
    switch: { closed: 67 / 158, open: 89 / 158 },
    battery: { on: 92 / 158 },
    lamp: { off: 118 / 158, on: 118 / 158 },
  },
}
const PALETTE_ICON = {
  battery: '/common/assets/circuit/schematic_battery_on_h.png',
  bulb: '/common/assets/circuit/schematic_lamp_off_h.png',
  switch: '/common/assets/circuit/schematic_switch_closed_h.png',
  ammeter: '/common/assets/circuit/schematic_ammeter_ammeter_h.png',
}

export default {
  data: {
    mode: 'schematic',
    palette: 'wire',
    edges: [],
    slots: [],
    guides: [],
    nodes: [],
    lines: [],
    comps: [],
    paletteItems: [],
    templateName: '串联',
    status: '',
    hintText: '',
    tplIdx: 0,
  },

  onInit() {
    this.buildNodes()
    this.buildPalette()
    this.loadTemplate(0)
  },

  onShow() {
    appGlobal.bind(this.$app)
    this.build()
  },

  buildNodes() {
    const arr = []
    for (let r = 0; r < 4; r++) {
      for (let c = 0; c < 4; c++) {
        const i = r * 4 + c
        arr.push({ i: i, x: NX[c] - 16, y: NY[r] - 16 })
      }
    }
    this.nodes = arr
  },

  buildPalette() {
    this.paletteItems = PALETTE.map(p => ({
      k: p.k,
      name: p.name,
      icon: PALETTE_ICON[p.k] || '',
      on: p.k === this.palette ? 'pbtn-on' : '',
    }))
  },

  loadTemplate(idx) {
    const t = TEMPLATES[idx % TEMPLATES.length]
    this.tplIdx = idx % TEMPLATES.length
    this.templateName = t.name
    this.edges = t.edges.map(e => ({ a: Math.min(e[0], e[1]), b: Math.max(e[0], e[1]), type: e[2], on: true }))
    this.build()
  },

  cycleTemplate() {
    appGlobal.tap()
    this.loadTemplate(this.tplIdx + 1)
  },

  setMode(m) {
    appGlobal.tap()
    this.mode = m
    this.build()
  },

  setPalette(k) {
    appGlobal.tap()
    this.palette = k
    this.buildPalette()
    this.build()
  },

  clearAll() {
    appGlobal.tap()
    this.edges = []
    this.templateName = '自定义'
    this.build()
  },

  nodeAt(i) {
    return { r: Math.floor(i / 4), c: i % 4, x: NX[i % 4], y: NY[Math.floor(i / 4)] }
  },

  edgeIndex(a, b) {
    const lo = Math.min(a, b)
    const hi = Math.max(a, b)
    for (let i = 0; i < this.edges.length; i++) {
      if (this.edges[i].a === lo && this.edges[i].b === hi) return i
    }
    return -1
  },

  tapEdge(a, b) {
    appGlobal.tap()
    if (this.mode !== 'schematic') return
    const idx = this.edgeIndex(a, b)
    if (this.palette === 'erase') {
      if (idx >= 0) this.edges.splice(idx, 1)
    } else if (idx >= 0) {
      this.edges[idx].type = this.palette
      this.edges[idx].on = true
    } else {
      this.edges.push({
        a: Math.min(a, b),
        b: Math.max(a, b),
        type: this.palette,
        on: true,
      })
    }
    this.templateName = '自定义'
    this.build()
  },

  tapComp(id) {
    appGlobal.tap()
    let idx = -1
    for (let i = 0; i < this.edges.length; i++) {
      if (this.edges[i].a + '-' + this.edges[i].b === id) { idx = i; break }
    }
    if (idx < 0) return
    const e = this.edges[idx]
    if (this.palette === 'erase' && this.mode === 'schematic') {
      this.edges.splice(idx, 1)
    } else if (e.type === 'switch') {
      e.on = !e.on
    } else if (this.mode === 'schematic') {
      e.type = this.palette === 'erase' ? e.type : this.palette
      e.on = true
    } else {
      return
    }
    this.templateName = '自定义'
    this.build()
  },

  build() {
    this.buildNodes()
    this.buildPalette()
    const slots = []
    for (let r = 0; r < 4; r++) {
      for (let c = 0; c < 4; c++) {
        const i = r * 4 + c
        if (c < 3) slots.push({ a: i, b: i + 1, x: NX[c] + 30, y: NY[r] - 12, w: 48, h: 24 })
        if (r < 3) slots.push({ a: i, b: i + 4, x: NX[c] - 12, y: NY[r] + 20, w: 24, h: 48 })
      }
    }
    const guides = []
    for (let r = 0; r < 4; r++) {
      for (let c = 0; c < 4; c++) {
        if (c < 3) guides.push({ x: NX[c], y: NY[r] - 1, w: 108, h: 2 })
        if (r < 3) guides.push({ x: NX[c] - 1, y: NY[r], w: 2, h: 88 })
      }
    }
    this.guides = guides
    this.slots = slots
    const analysis = analyzeCircuit(this.edges)
    const lines = []
    const comps = []
    const count = { battery: 0, bulb: 0, switch: 0, ammeter: 0 }
    for (let i = 0; i < this.edges.length; i++) {
      const e = this.edges[i]
      const a = this.nodeAt(e.a)
      const b = this.nodeAt(e.b)
      if (!a || !b) continue
      const horiz = a.r === b.r
      const thick = this.mode === 'real' ? 5 : 2
      if (horiz) {
        lines.push({
          x: Math.min(a.x, b.x), y: a.y - Math.floor(thick / 2),
          w: Math.abs(a.x - b.x), h: thick,
          cls: this.mode === 'real' ? 'line-real' : '',
        })
      } else {
        lines.push({
          x: a.x - Math.floor(thick / 2), y: Math.min(a.y, b.y),
          w: thick, h: Math.abs(a.y - b.y),
          cls: this.mode === 'real' ? 'line-real' : '',
        })
      }
      if (e.type === 'wire') continue
      let label = ''
      if (e.type === 'battery') { count.battery++; label = 'E' + count.battery }
      else if (e.type === 'bulb') { count.bulb++; label = 'L' + count.bulb }
      else if (e.type === 'switch') { count.switch++; label = 'S' + count.switch }
      else { count.ammeter++; label = 'A' + count.ammeter }
      const rd = analysis.readings[e.a + '-' + e.b] || { current: 0 }
      const cur = Math.abs(rd.current || 0)
      const lit = e.type === 'bulb' && cur > 1e-6
      const dir = horiz ? 'h' : 'v'
      const state = e.type === 'bulb' ? (lit ? 'on' : 'off')
        : e.type === 'switch' ? (e.on ? 'closed' : 'open')
        : e.type === 'battery' ? 'on' : 'ammeter'
      const modeKey = this.mode === 'real' ? 'physical' : 'schematic'
      const iconType = e.type === 'bulb' ? 'lamp' : e.type
      const size = ICON_SIZE[modeKey][iconType] || ICON_SIZE[modeKey].lamp
      let iw = size[dir][0]
      let ih = size[dir][1]
      if (e.type === 'switch') {
        const ratio = ICON_RATIO[modeKey].switch[state]
        if (dir === 'h') ih = Math.round(iw * ratio)
        else iw = Math.round(ih * ratio)
      }
      const cw = dir === 'h' ? Math.max(64, iw) : Math.max(34, iw + 4)
      const ch = dir === 'h' ? Math.max(34, ih + 4) : Math.max(64, ih)
      comps.push({
        id: e.a + '-' + e.b,
        x: (a.x + b.x) / 2 - cw / 2,
        y: (a.y + b.y) / 2 - ch / 2,
        cw: cw,
        ch: ch,
        label: label,
        img: '/common/assets/circuit/' + modeKey + '_' + iconType + '_' + state + '_' + dir + '.png',
        iw: iw,
        ih: ih,
        ix: Math.round((cw - iw) / 2),
        iy: Math.round((ch - ih) / 2),
        curText: e.type === 'ammeter' ? (cur.toFixed(2) + 'A') : '',
      })
    }
    this.lines = lines
    this.comps = comps
    const n = comps.length
    const flow = analysis.current > 1e-9 ? ('I=' + analysis.current.toFixed(2) + 'A') : '无电流'
    const ampText = comps.filter(c => c.curText).map(c => c.label + '=' + c.curText).join(' ')
    this.status = analysis.status === 'short'
      ? '短路 · 请断开导线'
      : (analysis.powered ? ((analysis.type || this.templateName) + ' · 通路 · ' + flow + (ampText ? ' · ' + ampText : ''))
        : ((analysis.type || this.templateName) + ' · 无电流' + (ampText ? ' · ' + ampText : '')))
    this.hintText = this.mode === 'real'
      ? '实物连接图 · 粗线是导线 · 点开关可切换通断'
      : '当前：' + (TYPE_NAME[this.palette] || '导线') + ' · 点两节点之间的线段放置'
  },

  back() {
    appGlobal.tap()
    router.back()
  },
}
</script>

<style>
  @import '../../common/style/base.css';

  .circuit { position: relative; width: 100%; height: 100%; padding: 0; overflow: hidden; background-color: #000000; }
  .stage { position: relative; width: 432px; min-width: 432px; height: 514px; min-height: 514px; flex-shrink: 0; flex-direction: column; }
  .hd { position: absolute; left: 0; top: 0; width: 432px; height: 40px; }
  .back { position: absolute; left: 10px; top: 2px; width: 64px; height: 36px; line-height: 36px; font-size: 26px; color: #7aa7ff; text-align: center; }
  .title { position: absolute; left: 100px; top: 4px; width: 232px; height: 34px; line-height: 34px; font-size: 31px; font-weight: bold; color: #ffffff; text-align: center; }
  .tpl { position: absolute; right: 8px; top: 7px; width: 64px; height: 28px; line-height: 28px; font-size: 14px; color: #7aa7ff; text-align: center; }

  .tabs { position: absolute; left: 24px; top: 42px; width: 384px; height: 34px; flex-direction: row; }
  .tab { width: 184px; height: 34px; margin-left: 4px; margin-right: 4px; border-radius: 17px; align-items: center; justify-content: center; }
  .tab-on { background-color: #2f6fed; }
  .tab-off { background-color: #1c1c1e; }
  .tab-t { font-size: 16px; color: #ffffff; text-align: center; }

  .status { position: absolute; left: 14px; top: 79px; width: 316px; height: 16px; line-height: 16px; font-size: 11px; color: #8e8e93; }
  .clr { position: absolute; left: 344px; top: 76px; width: 72px; height: 24px; border-radius: 12px; background-color: #1c1c1e; align-items: center; justify-content: center; }
  .clr-t { font-size: 12px; color: #ff8a65; text-align: center; }

  .line { position: absolute; background-color: #b6a4d5; }
  .line-empty { background-color: #1c1c1c; }
  .slot { position: absolute; background-color: rgba(0, 0, 0, 0.01); }
  .line-real { background-color: #90a4ae; }
  .comp { position: absolute; align-items: center; justify-content: center; flex-shrink: 0; }
  .cimg { position: absolute; }
  .clabel { position: absolute; top: -13px; left: 0; width: 100%; height: 12px; line-height: 12px; font-size: 10px; color: #d8d8d8; text-align: center; }
  .creading { position: absolute; left: 0; bottom: -11px; width: 100%; height: 10px; line-height: 10px; font-size: 9px; color: #54cc58; text-align: center; }

  .real .clabel { color: #ffffff; }
  .real.comp-battery { background-color: #263d4d; border-color: #82b1ff; }
  .real.comp-battery .csym { color: #ffffff; font-size: 11px; }
  .real.comp-bulb { background-color: #ffd54f; border-color: #ffe082; }
  .real.comp-bulb .csym { color: #3a2a00; }
  .real.comp-switch { background-color: #4d3b26; border-color: #ffb74d; }
  .real.comp-switch .csym { color: #ffffff; }
  .real.comp-ammeter { background-color: #e0e0e0; border-color: #ffffff; }
  .real.comp-ammeter .csym { color: #1a1a1a; font-weight: bold; }

  .node { position: absolute; width: 32px; height: 32px; border-radius: 16px; align-items: center; justify-content: center; }
  .ndot { width: 8px; height: 8px; border-radius: 4px; background-color: #8c70b2; }
  .node-on { background-color: #263d4d; }
  .node-on .ndot { width: 12px; height: 12px; border-radius: 6px; background-color: #2f6fed; }

  .palette { position: absolute; left: 18px; top: 414px; width: 396px; height: 36px; flex-direction: row; }
  .pbtn { width: 60px; min-width: 60px; height: 36px; min-height: 36px; flex-shrink: 0; margin-left: 3px; margin-right: 3px; border-radius: 10px; background-color: #1c1c1e; flex-direction: row; align-items: center; justify-content: center; }
  .pbtn-on { background-color: #2f6fed; }
  .pimg { width: 22px; height: 22px; margin-right: 2px; }
  .pbtn-t { font-size: 10px; color: #ffffff; text-align: center; }
  .hint { position: absolute; left: 14px; top: 462px; width: 404px; height: 18px; line-height: 18px; font-size: 10px; color: #6b7078; text-align: center; }
</style>
