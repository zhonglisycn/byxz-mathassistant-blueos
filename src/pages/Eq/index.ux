<template>
  <div class="page">    <scroll class="scroll" scroll-y if="{{picking}}">

    <div class="toptitle">
      <text class="t-title" style="font-size: 31px">方程求解</text>


    </div>


    <div class="topnav">
      <text class="t-nav" style="font-size: 29px; height: 61px" @click="back">‹ 返回</text>


    </div>

    <!-- 第一步：选类型（列表行，整行一个大触点） -->
      <text class="sec" style="font-size: 23px">要解哪种方程</text>
      <div class="row" for="{{modes}}" tid="k" @click="setMode($item.k)">
        <div class="row-main">
          <text class="row-title" style="font-size: 31px">{{$item.name}}</text>
          <text class="row-sub" style="font-size: 23px">{{$item.hint}}</text>
        </div>
        <text class="row-go t-icon">›</text>
      </div>
      <div class="gap"></div>
    </scroll>

    <!-- 第二步：输入与结果 -->
    <scroll class="scroll" scroll-y if="{{!picking}}">
      <div class="row" @click="toPick">
        <div class="row-main">
          <text class="row-title" style="font-size: 29px">{{curName}}</text>
          <text class="row-sub" style="font-size: 23px">{{curHint}}</text>
        </div>
        <text class="row-go t-icon">›</text>
      </div>

      <div class="inp" if="{{free}}">
        <text class="t-dis" style="color: #e8e8e8; font-size: 31px; text-align: left">{{shown}}</text>
        <text class="t-help" style="font-size: 22px; text-align: left">{{desc}}</text>
      </div>

      <text class="t-sub" style="font-size: 23px; width: 100%; margin-bottom: 5px" if="{{!free}}">{{form}}</text>
      <div class="chips" if="{{!free}}">
        <div class="chip {{$item.on ? 'chip-on' : ''}}" for="{{fields}}" tid="k" @click="pick($item.k)">
          <text class="t-chip" style="font-size: 27px; color: #ffffff">{{$item.text}}</text>
        </div>
      </div>

      <div class="result" if="{{solved}}">
        <text class="t-sub" style="font-size: 23px; width: 100%">{{general}}</text>
        <text class="t-ok" style="font-size: 34px; width: 100%; margin-top: 7px">{{answer}}</text>
      </div>
      <div if="{{solved}}">
        <text class="t-step" style="font-size: 25px" for="{{steps}}" tid="i">{{$item}}</text>
      </div>

            <div class="pad" if="{{!solved && free}}">
      <div class="prow">
        <div class="key" @click="tap('7')"><text class="t-key" style="color: #ffffff">7</text></div>
        <div class="key" @click="tap('8')"><text class="t-key" style="color: #ffffff">8</text></div>
        <div class="key" @click="tap('9')"><text class="t-key" style="color: #ffffff">9</text></div>
        <div class="key" @click="tap('←')"><text class="t-icon" style="color: #ffffff">←</text></div>
      </div>
      <div class="prow">
        <div class="key" @click="tap('4')"><text class="t-key" style="color: #ffffff">4</text></div>
        <div class="key" @click="tap('5')"><text class="t-key" style="color: #ffffff">5</text></div>
        <div class="key" @click="tap('6')"><text class="t-key" style="color: #ffffff">6</text></div>
        <div class="key" @click="tap('C')"><text class="t-key" style="color: #ff6b6b">C</text></div>
      </div>
      <div class="prow">
        <div class="key" @click="tap('1')"><text class="t-key" style="color: #ffffff">1</text></div>
        <div class="key" @click="tap('2')"><text class="t-key" style="color: #ffffff">2</text></div>
        <div class="key" @click="tap('3')"><text class="t-key" style="color: #ffffff">3</text></div>
        <div class="key" @click="tap('x')"><text class="t-key" style="color: #32a3ff">x</text></div>
      </div>
      <div class="prow">
        <div class="key" @click="tap('0')"><text class="t-key" style="color: #ffffff">0</text></div>
        <div class="key" @click="tap('.')"><text class="t-key" style="color: #ffffff">.</text></div>
        <div class="key" @click="tap('−')"><text class="t-key" style="color: #ffffff">−</text></div>
        <div class="key" @click="tap('+')"><text class="t-key" style="color: #ffffff">+</text></div>
      </div>
      <div class="prow">
        <div class="key" @click="tap('=')"><text class="t-key" style="color: #32a3ff">=</text></div>
        <div class="key" @click="tap('(')"><text class="t-key" style="color: #32a3ff">(</text></div>
        <div class="key" @click="tap(')')"><text class="t-key" style="color: #32a3ff">)</text></div>
        <div class="key" @click="tap('^')"><text class="t-key" style="color: #ffffff">^</text></div>
      </div>
      <div class="prow">
        <div class="key" @click="tap('×')"><text class="t-key" style="color: #ffffff">×</text></div>
        <div class="key" @click="tap('÷')"><text class="t-key" style="color: #ffffff">÷</text></div>
        <div class="key" @click="tap('π')"><text class="t-key" style="color: #ffffff">π</text></div>
        <div class="key" @click="tap('e')"><text class="t-key" style="color: #ffffff">e</text></div>
      </div>
      <div class="prow">
        <div class="key" @click="tap('√')"><text class="t-key" style="color: #ffffff">√</text></div>
        <div class="key" @click="tap('sin')"><text class="t-key-sm" style="color: #32a3ff">sin</text></div>
        <div class="key" @click="tap('ln')"><text class="t-key-md" style="color: #32a3ff">ln</text></div>
        <div class="key" @click="tap('log')"><text class="t-key-sm" style="color: #32a3ff">log</text></div>
      </div>
      </div>
      <div class="pad" if="{{!solved && !free}}">
      <div class="prow">
        <div class="key" @click="tap('7')"><text class="t-key" style="color: #ffffff">7</text></div>
        <div class="key" @click="tap('8')"><text class="t-key" style="color: #ffffff">8</text></div>
        <div class="key" @click="tap('9')"><text class="t-key" style="color: #ffffff">9</text></div>
        <div class="key" @click="tap('←')"><text class="t-icon" style="color: #ffffff">←</text></div>
      </div>
      <div class="prow">
        <div class="key" @click="tap('4')"><text class="t-key" style="color: #ffffff">4</text></div>
        <div class="key" @click="tap('5')"><text class="t-key" style="color: #ffffff">5</text></div>
        <div class="key" @click="tap('6')"><text class="t-key" style="color: #ffffff">6</text></div>
        <div class="key" @click="tap('C')"><text class="t-key" style="color: #ff6b6b">C</text></div>
      </div>
      <div class="prow">
        <div class="key" @click="tap('1')"><text class="t-key" style="color: #ffffff">1</text></div>
        <div class="key" @click="tap('2')"><text class="t-key" style="color: #ffffff">2</text></div>
        <div class="key" @click="tap('3')"><text class="t-key" style="color: #ffffff">3</text></div>
        <div class="key" @click="tap('−')"><text class="t-key" style="color: #ffffff">−</text></div>
      </div>
      <div class="prow">
        <div class="key" @click="tap('0')"><text class="t-key" style="color: #ffffff">0</text></div>
        <div class="key" @click="tap('.')"><text class="t-key" style="color: #ffffff">.</text></div>
        <div class="key" @click="tap('+')"><text class="t-key" style="color: #ffffff">+</text></div>
        <div class="key" @click="tap('')"><text class="t-key" style="color: #ffffff"></text></div>
      </div>
      </div>

      <div class="pill" if="{{!solved}}" @click="solve">
        <text class="t-pill" style="font-size: 31px">求解</text>
      </div>
      <div class="pill pill-quiet" if="{{solved}}" @click="edit">
        <text class="t-pill" style="font-size: 31px">改参数</text>
      </div>
      <div class="gap"></div>
    </scroll>
  </div>
</template>

<script>
import router from '@blueos.app.appmanager.router'
import appGlobal from '../../common/core/app.js'
import { solveLinear, solveQuadratic, solveSystem2, solveNumeric, solveEquation } from '../../common/core/solver.js'
import { formatExact, formatNumber } from '../../common/core/calc.js'
import { descOf } from '../../common/core/keys.js'

const MODES = [
  { k: 'free', name: '自由式子', hint: '直接写 2x+3=7、x²−3x=−2，会自动化为一般式' },
  { k: 'line', name: '一次方程', hint: 'a·x + b = 0' },
  { k: 'quad', name: '二次方程', hint: 'a·x² + b·x + c = 0，含复根与顶点' },
  { k: 'sys', name: '二元一次方程组', hint: 'a₁x + b₁y = c₁ ； a₂x + b₂y = c₂' },
  { k: 'any', name: '数值求根', hint: 'f(x) = 0，在 −20 ~ 20 之间找实根' }
]

const FIELDS = {
  line: [{ k: 'a', val: '1' }, { k: 'b', val: '0' }],
  quad: [{ k: 'a', val: '1' }, { k: 'b', val: '0' }, { k: 'c', val: '0' }],
  sys: [
    { k: 'a1', val: '1' }, { k: 'b1', val: '1' }, { k: 'c1', val: '3' },
    { k: 'a2', val: '1' }, { k: 'b2', val: '-1' }, { k: 'c2', val: '1' }
  ]
}

const FORMS = {
  line: 'a·x + b = 0',
  quad: 'a·x² + b·x + c = 0',
  sys: 'a₁x + b₁y = c₁ ； a₂x + b₂y = c₂'
}

// 系数模式只需要数字与负号；自由式子还要运算符与函数
const KEYS_NUM = ['7', '8', '9', '←', '4', '5', '6', 'C', '1', '2', '3', '−', '0', '.', '+', '']
const KEYS_FREE = [
  '7', '8', '9', '←',
  '4', '5', '6', 'C',
  '1', '2', '3', 'x',
  '0', '.', '−', '+',
  '=', '(', ')', '^',
  '×', '÷', 'π', 'e',
  '√', 'sin', 'ln', 'log'
]

function buildKeys(free) {
  const list = free ? KEYS_FREE : KEYS_NUM
  const out = []
  for (let i = 0; i < list.length; i++) {
    const k = list[i]
    if (!k) { out.push({ k: '', label: '', cls: 't-key-sm', color: '#ffffff' }); continue }
    let color = '#ffffff', cls = 't-key'
    if (k === '←') cls = 't-icon'
    else if (k === 'C') color = '#ff6b6b'
    else if ('−+×÷^'.indexOf(k) >= 0) color = '#f7b336'
    else if (k === '=' || k === 'x' || k === '(' || k === ')') color = '#32a3ff'
    else if (k === 'π' || k === 'e') color = '#e34afe'
    else if (k.length >= 2) { color = '#32a3ff'; cls = 't-key-sm' }   // sin/ln/log/√
    out.push({ k: k, label: k, cls: cls, color: color })
  }
  return out
}

const APPEND = { '×': '*', '÷': '/', '−': '-', '√': 'sqrt(' }

export default {
  data: {
    desc: '',
    modes: MODES,
    picking: true,
    mode: 'free',
    curName: '自由式子',
    curHint: '',
    free: true,
    form: '',
    fields: [],
    curKey: '',
    keys: [],
    text: '2x+3=7',
    cur: 8,
    shown: '2x+3=7|',
    solved: false,
    general: '',
    answer: '',
    steps: []
  },


  onInit() { this.picking = true },

  onShow() {},

  setMode(k) {
    appGlobal.tap()
    this.mode = k
    this.picking = false
    for (let i = 0; i < MODES.length; i++) {
      if (MODES[i].k === k) { this.curName = MODES[i].name; this.curHint = MODES[i].hint }
    }
    this.free = (k === 'free' || k === 'any')
    this.form = FORMS[k] || ''
    this.fields = (FIELDS[k] || []).map(f => ({ k: f.k, val: f.val, on: false, text: f.k + ' = ' + f.val }))
    this.curKey = this.fields.length ? this.fields[0].k : ''
    this.keys = buildKeys(this.free)
    this.solved = false
    this.answer = ''
    this.general = ''
    this.steps = []
    this.text = (k === 'any') ? 'x^2-2' : '2x+3=7'
    this.cur = this.text.length
    this.syncChips()
    this.refresh()
  },

  toPick() {
    appGlobal.tap()
    this.picking = true
  },

  pick(k) {
    appGlobal.tap()
    this.curKey = k
    this.syncChips()
  },

  syncChips() {
    this.fields = this.fields.map(f => ({
      k: f.k, on: f.k === this.curKey,
      text: f.k + ' = ' + (f.k === this.curKey ? (f.val || '_') : f.val)
    }))
  },

  refresh() {
    if (!this.free) return
    this.shown = (this.text.slice(0, this.cur) + '|' + this.text.slice(this.cur)) || '|'
  },

  curField() {
    for (let i = 0; i < this.fields.length; i++) if (this.fields[i].k === this.curKey) return this.fields[i]
    return this.fields[0]
  },

  tap(k) {
    appGlobal.tap()
    if (!k) return
    const d = descOf(k)
    this.desc = d ? (k + '：' + d) : ''
    if (!this.free) {
      const f = this.curField()
      if (!f) return
      if (k === 'C') f.val = ''
      else if (k === '←') f.val = f.val.slice(0, -1)
      else if (k === '−') f.val = f.val.charAt(0) === '-' ? f.val.slice(1) : '-' + f.val
      else if (f.val.length < 24) f.val += k
      this.syncChips()
      return
    }
    if (k === 'C') { this.text = ''; this.cur = 0; this.refresh(); return }
    if (k === '←') {
      if (this.cur > 0) {
        this.text = this.text.slice(0, this.cur - 1) + this.text.slice(this.cur)
        this.cur--
      }
      this.refresh()
      return
    }
    const add = APPEND[k] || k
    if (this.text.length < 48) {
      this.text = this.text.slice(0, this.cur) + add + this.text.slice(this.cur)
      this.cur += add.length
    }
    this.refresh()
  },

  one(v, exact) {
    if (exact) {
      const e = formatExact(v)
      if (e !== null) return e
    }
    return formatNumber(v)
  },

  rootText(roots, exact) {
    const out = []
    for (let i = 0; i < roots.length; i++) {
      const r = roots[i]
      const tag = 'x' + (roots.length > 1 ? (i + 1) : '')
      if (Math.abs(r.im) < 1e-12) out.push(tag + ' = ' + this.one(r.re, exact))
      else {
        const im = Math.abs(r.im)
        const imTxt = (Math.abs(im - 1) < 1e-12 ? '' : this.one(im, exact)) + 'i'
        out.push(tag + ' = ' + this.one(r.re, exact) + (r.im > 0 ? ' + ' : ' − ') + imTxt)
      }
    }
    return out.join('，')
  },

  solve() {
    const app = appGlobal
    const exact = !!app.exact
    let general = ''
    let answer = ''
    let steps = []

    if (this.mode === 'free') {
      const r = solveEquation(this.text, {})
      if (!r.ok) answer = r.err
      else {
        general = r.general
        if (r.any) answer = '任意 x 都成立'
        else if (r.none) answer = '无解'
        else answer = r.roots.length ? this.rootText(r.roots, exact) : '没有实根'
        steps = r.steps
      }
    } else if (this.mode === 'any') {
      const r = solveNumeric(this.text, { xmin: -20, xmax: 20, steps: 800 })
      general = 'f(x) = 0'
      if (!r.ok) answer = r.err
      else if (!r.roots.length) { answer = '这段区间里没有实根'; steps = r.steps }
      else {
        answer = this.rootText(r.roots.map(v => ({ re: v, im: 0 })), exact)
        steps = r.steps
      }
    } else {
      const v = {}
      for (let i = 0; i < this.fields.length; i++) v[this.fields[i].k] = this.fields[i].val
      const num = (s) => {
        if (s === '' || s === '-' || s === '.' || s === '-.') return 0
        const n = parseFloat(s)
        return isFinite(n) ? n : 0
      }
      general = FORMS[this.mode] || ''
      if (this.mode === 'line') {
        const r = solveLinear(num(v.a), num(v.b))
        answer = r.ok ? (r.any ? '任意 x 都成立' : this.rootText(r.roots.map(x => ({ re: x, im: 0 })), exact)) : r.err
        steps = r.steps
      } else if (this.mode === 'quad') {
        const r = solveQuadratic(num(v.a), num(v.b), num(v.c))
        answer = r.ok ? this.rootText(r.roots, exact) : r.err
        steps = r.steps || []
      } else {
        const r = solveSystem2(num(v.a1), num(v.b1), num(v.c1), num(v.a2), num(v.b2), num(v.c2))
        if (r.any) answer = '无穷多组解（两直线重合）'
        else if (r.none) answer = '无解（两直线平行）'
        else answer = 'x = ' + this.one(r.x, exact) + '，y = ' + this.one(r.y, exact)
        steps = r.steps
      }
    }

    this.general = general
    this.answer = answer
    this.steps = (steps && steps.length) ? steps : ['没有更多步骤']
    this.solved = true
  },

  edit() {
    appGlobal.tap()
    this.solved = false
  },

  back() {
    appGlobal.tap()
    if (!this.picking) { this.picking = true; return }
    router.back()
  }
}
</script>

<style>
  @import '../../common/style/base.css';

  .inp {
    width: 100%;
    min-height: 72px;
    background-color: #111111;
    border-radius: 25px;
    align-items: center;
    padding-left: 22px;
    padding-right: 22px;
    margin-bottom: 11px;
  }

  .chips { width: 100%; flex-direction: row; flex-wrap: wrap; margin-bottom: 11px; }

  .chip {
    height: 54px;
    border-radius: 27px;
    background-color: #2a2a2c;
    align-items: center;
    justify-content: center;
    padding-left: 18px;
    padding-right: 18px;
    margin: 4px 7px 4px 0;
  }

  .chip-on { background-color: #2f6fed; }
  .t-chip { font-size: 27px; }

  .t-step { color: #b9bec6; width: 100%; margin-top: 5px; }

  .t-help { color: #8b8f96; width: 100%; }
  .gap { width: 100%; height: 22px; }
</style>
